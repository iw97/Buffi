NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Vercel: set all NEXT_PUBLIC_FIREBASE_* in Project → Settings → Environment variables.
# Missing keys leave `auth` null and sign-in will throw "Auth is not initialized".

# Server-only: Firebase service account JSON (minified one line). Required for:
# - /api/scan productScans aggregation
# - POST /api/waitlist (Firestore writes; avoids browser-only Firebase config failures)
# Create a key in Firebase Console → Project settings → Service accounts → Generate new private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Public site URL (Firebase email-link continue URL = NEXT_PUBLIC_APP_URL + /auth/callback).
# Local dev: http://localhost:3000
# Vercel Production: https://buffi.app
# Vercel Preview: optional — leave unset to use VERCEL_URL (exposed as NEXT_PUBLIC_VERCEL_URL via next.config.js).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing: Google Form (or other) URL — embedded on /waitlist; CTAs open that page. If unset, /waitlist shows setup instructions.
# NEXT_PUBLIC_WAITLIST_URL=https://docs.google.com/forms/d/e/.../viewform

# Resend (https://resend.com) — notify heybuffi@gmail.com on new waitlist signups via POST /api/waitlist
# RESEND_API_KEY=re_xxxxxxxx
# Optional: verified sender (default: Resend onboarding address for testing). Production: e.g. Buffi <notifications@yourdomain.com>
# RESEND_FROM_EMAIL=

# Stripe (Buffi Pro — Checkout + webhooks)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # Signing secret from Stripe Dashboard → Developers → Webhooks (or `stripe listen`)
# Create prices once: npm run stripe:seed (requires STRIPE_SECRET_KEY), then set:
# STRIPE_PRICE_WEEKLY=price_...
# STRIPE_PRICE_ANNUAL=price_...
# STRIPE_PRICE_LIFETIME=price_...

# Claude API (for scan analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Cloud Vision (tag label OCR)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key

# SerpAPI (Google Shopping price lookup; add to .env.local as SERPAPI_KEY)
# SERPAPI_KEY=your_serpapi_key

# URL scan cache: reuse productScans when lastScannedAt is within this many days (default 7). Set 0 to disable cache reads.
# CACHE_TTL_DAYS=7
