NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# App URL (for email-link sign-in callback). Development: http://localhost:3000; production: your live domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude API (for scan analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Cloud Vision (tag label OCR)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key

# SerpAPI (Google Shopping price lookup; add to .env.local as SERPAPI_KEY)
# SERPAPI_KEY=your_serpapi_key
