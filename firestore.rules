rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Internal intelligence — no client access (Admin SDK only).
    match /productScans/{document} {
      allow read, write: if false;
    }
    match /productMappings/{document} {
      allow read, write: if false;
    }
    match /pendingOnboarding/{document} {
      allow read, write: if false;
    }

    // users/{uid} — owner-only. Client reads require a valid auth token (uid match).
    // Magic-link sign-in: token may lag briefly; client retries getUserProfile on permission-denied.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Marketing waitlist — anonymous read/write for duplicate query + addDoc (legacy client).
    // Primary path: POST /api/waitlist (Admin SDK, bypasses rules). Deploy these rules if production
    // uses default-deny or omits the catch-all below. `read: if true` allows listing; tighten before launch.
    match /waitlist/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['firstName', 'email', 'joinedAt'])
        && request.resource.data.firstName is string
        && request.resource.data.email is string
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() < 200
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 320;
      allow update, delete: if false;
    }

    // TEMPORARY: permissive rules for other collections. Tighten before launch.
    // `users` is excluded so only the rule above applies (owner-only).
    match /{document=**} {
      allow read, write: if
        request.path.split('/')[0] != 'productScans'
        && request.path.split('/')[0] != 'productMappings'
        && request.path.split('/')[0] != 'users';
    }
  }
}
